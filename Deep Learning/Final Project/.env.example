# Copy this file to .env and fill in your own values. Never commit .env.

# Database: "sqlite" (local, no setup) or "azure"
DB_BACKEND=sqlite

# Azure SQL (only needed when DB_BACKEND=azure). Use the limited agent_user login.
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=pipelinepilot
AZURE_SQL_USER=agent_user
AZURE_SQL_PASSWORD=your-agent-password

# Optional LLM. Leave blank to use the built-in rule-based reasoning.
OPENAI_API_KEY=
# Or Azure OpenAI instead:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Learning settings
BANDIT_EPSILON=0.2
FEEDBACK_WEIGHT=0.25
RETRY_BASE_SECONDS=5
